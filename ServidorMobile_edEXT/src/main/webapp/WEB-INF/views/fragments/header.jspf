<header class="topbar">
    <a class="brand" href="${pageContext.request.contextPath}/app" aria-label="edEXT Mobile, inicio">
        <span class="brand-mark">e</span><span>edEXT <strong>Mobile</strong></span>
    </a>
    <details class="menu">
        <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
        <nav class="menu-panel" aria-label="Navegación">
            <button type="button" class="theme-toggle menu-theme-toggle" data-theme-toggle
                    aria-label="Cambiar a modo oscuro">
                <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
                </svg>
                <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"></path>
                </svg>
                <span data-theme-label>Modo oscuro</span>
            </button>
            <a href="${pageContext.request.contextPath}/app">Ver cursos</a>
            <form method="post" action="${pageContext.request.contextPath}/logout">
                <button type="submit">Cerrar sesión</button>
            </form>
        </nav>
    </details>
</header>
