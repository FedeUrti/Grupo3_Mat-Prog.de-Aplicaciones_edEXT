<%-- Fragmento compartido por el modal del perfil y la pantalla de edición independiente. --%>
<c:url var="modificarUsuarioUrl" value="/modificar-usuario"/>
<form action="<c:out value='${modificarUsuarioUrl}'/>" method="post" enctype="multipart/form-data"
      data-profile-edit-form>
    <div class="alert alert-danger d-none" role="alert" data-profile-edit-error></div>
    <div class="mb-3">
        <label class="form-label" for="editar-nickname">Nickname</label>
        <input class="form-control" id="editar-nickname" type="text"
               value="<c:out value='${usuario.nickname}'/>" readonly>
    </div>
    <div class="mb-3">
        <label class="form-label" for="editar-correo">Correo</label>
        <input class="form-control" id="editar-correo" type="email"
               value="<c:out value='${usuario.correo}'/>" readonly>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" for="editar-nombre">Nombre</label>
            <input class="form-control" id="editar-nombre" name="nombre" type="text"
                   value="<c:out value='${empty form_nombre ? usuario.nombre : form_nombre}'/>" required>
        </div>
        <div class="col-md-6">
            <label class="form-label" for="editar-apellido">Apellido</label>
            <input class="form-control" id="editar-apellido" name="apellido" type="text"
                   value="<c:out value='${empty form_apellido ? usuario.apellido : form_apellido}'/>" required>
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label" for="editar-fechaNacimiento">Fecha de nacimiento</label>
        <input class="form-control" id="editar-fechaNacimiento" name="fechaNacimiento" type="date"
               value="<c:out value='${empty form_fechaNacimiento ? usuario.fechaNacimiento : form_fechaNacimiento}'/>" required>
    </div>
    <div class="mb-4">
        <label class="form-label" for="editar-imagen">Nueva foto de perfil <span class="text-muted fw-normal">(opcional)</span></label>
        <input class="form-control" id="editar-imagen" name="imagen" type="file"
               accept="image/png,image/jpeg,image/gif,image/webp">
        <div class="form-text">Si no elegís una imagen, se conserva la actual.</div>
    </div>
    <div class="d-flex justify-content-end gap-2 border-top pt-3">
        <%-- El botón de cancelar depende de si el formulario está dentro del modal o en su propia página. --%>
        <c:choose>
            <c:when test="${formularioEnModal}">
                <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button>
            </c:when>
            <c:otherwise>
                <c:url var="consultaPerfilUrl" value="/consulta-usuario">
                    <c:param name="nickname" value="${usuario.nickname}"/>
                </c:url>
                <a class="btn btn-outline-secondary" href="<c:out value='${consultaPerfilUrl}'/>">Cancelar</a>
            </c:otherwise>
        </c:choose>
        <button class="btn btn-primary" type="submit" data-profile-edit-submit>
            <i class="bi bi-check2 me-1" aria-hidden="true"></i>Guardar cambios
        </button>
    </div>
</form>
