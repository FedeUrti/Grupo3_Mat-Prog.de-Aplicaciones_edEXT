# syntax=docker/dockerfile:1.7
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
# El cache de BuildKit conserva dependencias Maven entre builds sin incluirlas en la imagen final.
RUN --mount=type=cache,target=/root/.m2 mvn -B clean -pl ServidorCentral_edEXT -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/ServidorCentral_edEXT/target/servidor.jar /app/central.jar
EXPOSE 9128
# Sin argumentos, el JAR inicia únicamente el servidor SOAP.
ENTRYPOINT ["java", "-jar", "/app/central.jar"]
