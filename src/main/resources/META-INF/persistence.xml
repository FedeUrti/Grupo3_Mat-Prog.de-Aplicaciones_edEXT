<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
             
    <!-- El nombre de la unidad de persistencia lo usarás en el código Java -->
    <persistence-unit name="edEXT_PU" transaction-type="RESOURCE_LOCAL">
        
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <properties>
            <!-- Credenciales de tu Base de Datos MySQL -->
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3307/edext_db?serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value="TU_PASSWORD_AQUI"/>
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- Configuración de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
            
            <!-- ¡MUUUY IMPORTANTE! "update" crea las tablas automáticamente basadas en tus @Entity -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            
            <!-- Muestra el SQL en la consola para ayudarte a debuggear -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>